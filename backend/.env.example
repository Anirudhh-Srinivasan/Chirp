# Copy to .env and replace with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Default: backend/chirp.db. In Docker use sqlite:////data/chirp.db
# DATABASE_URL=sqlite:///./backend/chirp.db
